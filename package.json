{
  "name": "tian-agent",
  "productName": "Tian Agent",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Personal chief-of-staff agent",
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "Tian",
    "email": "tianzuo@live.cn"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "react:doctor": "react-doctor --no-score",
    "test": "pnpm build:service && tsx --test tests/*.test.ts",
    "test:runtime": "tsx scripts/e2e-runtime.mts",
    "test:launchd": "pnpm build:service && tsx scripts/e2e-service.mts",
    "test:upgrade": "pnpm build:service && tsx scripts/e2e-upgrades.mts",
    "test:app-upgrade": "tsx scripts/e2e-app-upgrade.mts",
    "build:service": "tsx scripts/build-payload.mts",
    "service:run": "node dist/service/service.cjs",
    "service:install": "pnpm build:service && tsx scripts/service.mts install",
    "service:start": "tsx scripts/service.mts start",
    "service:stop": "tsx scripts/service.mts stop",
    "service:restart": "tsx scripts/service.mts restart",
    "service:status": "tsx scripts/service.mts status",
    "service:uninstall": "tsx scripts/service.mts uninstall"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron-forge/shared-types": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.9.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.88.0",
    "react-doctor": "0.9.18",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.29",
    "@base-ui/react": "^1.9.0",
    "@daypicker/react": "^10.0.2",
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@pierre/diffs": "^1.5.2",
    "@tailwindcss/vite": "4.3.3",
    "@wechatbot/wechatbot": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "croner": "10.0.1",
    "electron-squirrel-startup": "^1.0.1",
    "motion": "^14.3.0",
    "pele": "^1.5.2",
    "proper-lockfile": "^4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semver": "^7.8.5",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.3",
    "typebox": "1.3.27"
  }
}
