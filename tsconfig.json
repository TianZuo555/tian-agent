{
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*.ts", "scripts/**/*.mts", "*.ts", "*.mts"]
}
