# Copy to .env (git-ignored) and fill in what you need.
#
# `mise run service:env` copies the MAGPIE_* and TELEGRAM_* keys into
# <dataDir>/service.env (0600) for the resident service; the Electron app reads
# them from the mise shell. Restart the service afterwards.
#
# Magpie gateway (defaults to http://127.0.0.1:3425/v1 when unset).
MAGPIE_BASE_URL=http://127.0.0.1:3425/v1
MAGPIE_API_KEY=
#
# Telegram adapter; no token keeps the adapter off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
#
# WeChat (iLink / ClawBot) adapter; an empty allow-list keeps the adapter off.
# After the first login the bot's own account id (…@im.bot) is shown in
# Settings → Channels; add your personal WeChat id (…@im.wechat) here.
WECHAT_ALLOWED_USER_IDS=
